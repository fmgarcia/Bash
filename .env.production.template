# ==================================
# PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN
# ==================================
# ⚠️ NO COMMITEAR ESTE ARCHIVO CON VALORES REALES
# Copiar y renombrar a .env en el servidor
# ==================================

# ========== BASE DE DATOS ==========
# Formato: mysql://usuario:contraseña@host:puerto/nombre_bd
# En EasyPanel, el host será el nombre del servicio MySQL (ej: "mysql")
DATABASE_URL=mysql://root:TU_PASSWORD_MYSQL@mysql:3306/gestion_scripts

# ========== JWT SECRETS ==========
# ⚠️ IMPORTANTE: Generar strings aleatorios de 64 caracteres hexadecimales
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_64_CARACTERES_HEX
JWT_REFRESH_SECRET=CAMBIAR_POR_OTRO_STRING_DIFERENTE_64_CARACTERES_HEX

# ========== URL DEL FRONTEND ==========
# URL donde estará desplegado tu frontend (sin barra final)
# Puede ser tu dominio personalizado o el subdominio de EasyPanel
FRONTEND_URL=https://tu-dominio.com

# ========== CONFIGURACIÓN DE NODE ==========
NODE_ENV=production
PORT=4000

# ========== CONFIGURACIÓN DE EJECUCIÓN ==========
# Modo de ejecución de scripts (headless para servidor)
EXECUTION_MODE=headless

# ========== LOGGING ==========
# Nivel de logs: error, warn, info, debug
LOG_LEVEL=info

# ========== DIRECTORIO TEMPORAL ==========
# Donde se guardarán scripts temporales durante ejecución
TMP_SCRIPT_DIR=/app/tmp

# ==================================
# INSTRUCCIONES PARA GENERAR JWT SECRETS:
# ==================================
# 1. Abre una terminal
# 2. Ejecuta: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 3. Copia el resultado para JWT_SECRET
# 4. Ejecuta de nuevo el comando para JWT_REFRESH_SECRET
# 5. Ambos deben ser diferentes
# ==================================
