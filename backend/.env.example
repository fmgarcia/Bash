# Base de datos MySQL (XAMPP)
DATABASE_URL="mysql://root:@localhost:3306/gestion_scripts"

# Secretos JWT (¡¡CAMBIAR EN PRODUCCIÓN!!)
JWT_SECRET="tu_secreto_jwt_muy_seguro_cambiar_en_produccion"
JWT_REFRESH_SECRET="tu_secreto_refresh_muy_seguro_cambiar_en_produccion"

# Puerto del servidor
PORT=4000

# URL del frontend (para CORS)
FRONTEND_URL="http://localhost:3000"

# Directorio temporal para scripts
TMP_SCRIPT_DIR="C:\\gestion-scripts\\tmp"

# Modo de ejecución: visible | headless
# visible: Abre ventana de PowerShell (requiere sesión de usuario con UI)
# headless: Ejecuta sin ventana y captura salida
EXECUTION_MODE="headless"

# Nivel de logging
LOG_LEVEL="info"

# Entorno
NODE_ENV="development"
